# Client runtime variables exposed through /api/runtime.js
VITE_APP_URL=http://localhost:4000
VITE_API_URL=http://localhost:4001

# Server
NODE_ENV=development
PORT=4001
STATIC_ROOT=apps/web/dist
# Supabase Connect panel: pooled runtime URL (server only). URL-encode passwords.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Direct or session-pooler URL for migrations and trusted setup.
DATABASE_MIGRATION_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4001/api/auth

# Trusted feedback setup only; never exposed to the browser.
FEEDBACK_ADMIN_EMAIL=exco@example.com
# Required only to create a NEW EXCO account; use a strong unique password.
FEEDBACK_ADMIN_PASSWORD=
SURVEY_SLUG=ardiente
SURVEY_TERM=Current semester

# Optional mail support for Better Auth password reset and verification emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASS=password
SMTP_FROM=no-reply@localhost

# Optional S3-compatible object storage, compatible with the MinIO compose service
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=app
FORCE_PATH_STYLE=true
