# Client runtime variables exposed through /api/runtime.js
VITE_APP_URL=http://localhost:4000
VITE_API_URL=http://localhost:4001

# Server
NODE_ENV=development
PORT=4001
STATIC_ROOT=apps/web/dist
# Supabase Connect panel: PostgreSQL runtime URL (not the HTTPS Project URL).
# URL-encode passwords and use an absolute sslrootcert path on your machine.
# The public Supabase CA is included in certs/supabase-root-2021.crt.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/Feedback/certs/supabase-root-2021.crt
# Direct or session-pooler URL for migrations and trusted setup.
DATABASE_MIGRATION_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/Feedback/certs/supabase-root-2021.crt
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4001/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trusted feedback setup only; never exposed to the browser.
FEEDBACK_ADMIN_EMAIL=ardiente@sa.smu.edu.sg
SURVEY_SLUG=ardiente
SURVEY_TERM=Current semester

# Optional mail integration; not required for Google sign-in or feedback collection.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional S3-compatible object storage, compatible with the MinIO compose service
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=
FORCE_PATH_STYLE=true
